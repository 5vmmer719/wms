<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.base.mapper.QualityStandardItemMapper">

    <resultMap type="QualityStandardItem" id="QualityStandardItemResult">
        <result property="itemId"         column="item_id"         />
        <result property="standardCode"   column="standard_code"   />
        <result property="itemNo"         column="item_no"         />
        <result property="itemName"       column="item_name"       />
        <result property="itemUnit"       column="item_unit"       />
        <result property="standardValue"  column="standard_value"  />
        <result property="minValue"       column="min_value"       />
        <result property="maxValue"       column="max_value"       />
        <result property="checkMethod"    column="check_method"    />
        <result property="isKey"          column="is_key"          />
        <result property="delFlag"        column="del_flag"        />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectQualityStandardItemVo">
        select item_id, standard_code, item_no, item_name, item_unit, standard_value, min_value, max_value, check_method, is_key, del_flag, create_by, create_time, update_by, update_time, remark from quality_standard_item
    </sql>

    <select id="selectQualityStandardItemByItemId" parameterType="Long" resultMap="QualityStandardItemResult">
        <include refid="selectQualityStandardItemVo"/>
        where del_flag = '0' AND item_id = #{itemId}
    </select>

    <select id="selectQualityStandardItemByStandardCode" parameterType="String" resultMap="QualityStandardItemResult">
        <include refid="selectQualityStandardItemVo"/>
        where del_flag = '0' AND standard_code = #{standardCode}
        order by item_no asc
    </select>

    <select id="selectQualityStandardItemList" parameterType="QualityStandardItem" resultMap="QualityStandardItemResult">
        <include refid="selectQualityStandardItemVo"/>
        <where>
            del_flag = '0'
            <if test="standardCode != null and standardCode != ''"> and standard_code = #{standardCode}</if>
            <if test="itemName != null and itemName != ''"> and item_name like concat('%', #{itemName}, '%')</if>
            <if test="isKey != null and isKey != ''"> and is_key = #{isKey}</if>
        </where>
        order by item_no asc
    </select>

    <insert id="insertQualityStandardItem" parameterType="QualityStandardItem" useGeneratedKeys="true" keyProperty="itemId">
        insert into quality_standard_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="standardCode != null and standardCode != ''">standard_code,</if>
            <if test="itemNo != null">item_no,</if>
            <if test="itemName != null and itemName != ''">item_name,</if>
            <if test="itemUnit != null">item_unit,</if>
            <if test="standardValue != null">standard_value,</if>
            <if test="minValue != null">min_value,</if>
            <if test="maxValue != null">max_value,</if>
            <if test="checkMethod != null">check_method,</if>
            <if test="isKey != null">is_key,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="standardCode != null and standardCode != ''">#{standardCode},</if>
            <if test="itemNo != null">#{itemNo},</if>
            <if test="itemName != null and itemName != ''">#{itemName},</if>
            <if test="itemUnit != null">#{itemUnit},</if>
            <if test="standardValue != null">#{standardValue},</if>
            <if test="minValue != null">#{minValue},</if>
            <if test="maxValue != null">#{maxValue},</if>
            <if test="checkMethod != null">#{checkMethod},</if>
            <if test="isKey != null">#{isKey},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <insert id="insertQualityStandardItemList">
        insert into quality_standard_item (standard_code, item_no, item_name, item_unit, standard_value, min_value, max_value, check_method, is_key, create_by, create_time)
        values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.standardCode}, #{item.itemNo}, #{item.itemName}, #{item.itemUnit}, #{item.standardValue}, #{item.minValue}, #{item.maxValue}, #{item.checkMethod}, #{item.isKey}, #{item.createBy}, #{item.createTime})
        </foreach>
    </insert>

    <update id="updateQualityStandardItem" parameterType="QualityStandardItem">
        update quality_standard_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="itemNo != null">item_no = #{itemNo},</if>
            <if test="itemName != null and itemName != ''">item_name = #{itemName},</if>
            <if test="itemUnit != null">item_unit = #{itemUnit},</if>
            <if test="standardValue != null">standard_value = #{standardValue},</if>
            <if test="minValue != null">min_value = #{minValue},</if>
            <if test="maxValue != null">max_value = #{maxValue},</if>
            <if test="checkMethod != null">check_method = #{checkMethod},</if>
            <if test="isKey != null">is_key = #{isKey},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where item_id = #{itemId}
    </update>

    <update id="deleteQualityStandardItemByItemId" parameterType="Long">
        update quality_standard_item set del_flag = '1' where item_id = #{itemId}
    </update>

    <update id="deleteQualityStandardItemByStandardCode" parameterType="String">
        update quality_standard_item set del_flag = '1' where standard_code = #{standardCode}
    </update>

</mapper>


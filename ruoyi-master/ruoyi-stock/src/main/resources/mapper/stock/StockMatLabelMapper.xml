<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.stock.mapper.StockMatLabelMapper">

    <resultMap type="StockMatLabel" id="StockMatLabelResult">
        <result property="labelId"    column="label_id"    />
        <result property="labelCode"    column="label_code"    />
        <result property="labelType"    column="label_type"    />
        <result property="matCode"    column="mat_code"    />
        <result property="batch"    column="batch"    />
        <result property="supplierCode"    column="supplier_code"    />
        <result property="supplierName"    column="supplier_name"    />
        <result property="prodTime"    column="prod_time"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="matName"    column="mat_name"    />
        <result property="fdCode"    column="fd_code"    />
        <result property="figNum"    column="fig_num"    />
        <result property="matGroup"    column="mat_group"    />
        <result property="matClass"    column="mat_class"    />
        <result property="unitCode"    column="unit_code"    />
        <result property="matGroupName"    column="group_name"    />
        <result property="matClassName"    column="class_name"    />
    </resultMap>

    <sql id="selectStockMatLabelVo">
        select l.label_id, l.label_code, l.label_type, l.mat_code, l.batch, l.supplier_code, l.supplier_name, l.prod_time,
               l.status, l.remark, l.del_flag, l.create_by, l.create_time, l.update_by, l.update_time,
               m.mat_name, m.fd_code, m.fig_num, m.mat_group, m.mat_class, m.unit_code,
               g.group_name, c.class_name
        from stock_mat_label l
        LEFT JOIN base_mat m ON l.mat_code = m.mat_code AND m.del_flag = '0'
        LEFT JOIN base_mat_group g ON m.mat_group = g.group_code AND g.del_flag = '0'
        LEFT JOIN base_mat_class c ON m.mat_class = c.class_code AND c.del_flag = '0'
    </sql>

    <select id="selectStockMatLabelList" parameterType="StockMatLabel" resultMap="StockMatLabelResult">
        <include refid="selectStockMatLabelVo"/>
        WHERE l.del_flag = 0
        <if test="labelCode != null and labelCode != ''"> and l.label_code = #{labelCode}</if>
        <if test="labelType != null and labelType != ''"> and l.label_type = #{labelType}</if>
        <if test="matCode != null and matCode != ''"> and l.mat_code = #{matCode}</if>
        <if test="matName != null and matName != ''"> and m.mat_name like concat('%', #{matName}, '%')</if>
        <if test="fdCode != null and fdCode != ''"> and m.fd_code = #{fdCode}</if>
        <if test="figNum != null and figNum != ''"> and m.fig_num = #{figNum}</if>
        <if test="matGroup != null and matGroup != ''"> and m.mat_group = #{matGroup}</if>
        <if test="matClass != null and matClass != ''"> and m.mat_class = #{matClass}</if>
        <if test="batch != null and batch != ''"> and l.batch = #{batch}</if>
        <if test="supplierCode != null and supplierCode != ''"> and l.supplier_code = #{supplierCode}</if>
        <if test="supplierName != null and supplierName != ''"> and l.supplier_name like concat('%', #{supplierName}, '%')</if>
        <if test="prodTime != null"> and l.prod_time = #{prodTime}</if>
        <if test="status != null and status != ''"> and l.status = #{status}</if>
        ORDER BY l.create_time DESC
    </select>

    <select id="selectStockMatLabelListDialog" parameterType="StockMatLabel" resultMap="StockMatLabelResult">
        <include refid="selectStockMatLabelVo"/>
        WHERE l.del_flag = 0 AND l.status = '0'
        <if test="labelCode != null and labelCode != ''"> and l.label_code = #{labelCode}</if>
        <if test="labelType != null and labelType != ''"> and l.label_type = #{labelType}</if>
        <if test="matCode != null and matCode != ''"> and l.mat_code = #{matCode}</if>
        <if test="matName != null and matName != ''"> and m.mat_name like concat('%', #{matName}, '%')</if>
        <if test="fdCode != null and fdCode != ''"> and m.fd_code = #{fdCode}</if>
        <if test="figNum != null and figNum != ''"> and m.fig_num = #{figNum}</if>
        <if test="matGroup != null and matGroup != ''"> and m.mat_group = #{matGroup}</if>
        <if test="matClass != null and matClass != ''"> and m.mat_class = #{matClass}</if>
        <if test="batch != null and batch != ''"> and l.batch = #{batch}</if>
        <if test="supplierCode != null and supplierCode != ''"> and l.supplier_code = #{supplierCode}</if>
        <if test="supplierName != null and supplierName != ''"> and l.supplier_name like concat('%', #{supplierName}, '%')</if>
        <if test="prodTime != null"> and l.prod_time = #{prodTime}</if>
        <if test="warehouseType != null and warehouseType != ''"> and g.default_warehouse_type = #{warehouseType}</if>
    </select>

    <select id="selectStockMatLabelByLabelId" parameterType="Long" resultMap="StockMatLabelResult">
        <include refid="selectStockMatLabelVo"/>
        where l.del_flag = 0 AND l.label_id = #{labelId}
    </select>

    <select id="selectStockMatLabelByLabelCode" parameterType="String" resultMap="StockMatLabelResult">
        <include refid="selectStockMatLabelVo"/>
        where l.del_flag = 0 AND l.label_code = #{labelCode}
    </select>

    <insert id="insertStockMatLabel" parameterType="StockMatLabel" useGeneratedKeys="true" keyProperty="labelId">
        insert into stock_mat_label
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="labelCode != null and labelCode != ''">label_code,</if>
            <if test="labelType != null and labelType != ''">label_type,</if>
            <if test="matCode != null and matCode != ''">mat_code,</if>
            <if test="batch != null and batch != ''">batch,</if>
            <if test="supplierCode != null and supplierCode != ''">supplier_code,</if>
            <if test="supplierName != null and supplierName != ''">supplier_name,</if>
            <if test="prodTime != null">prod_time,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="labelCode != null and labelCode != ''">#{labelCode},</if>
            <if test="labelType != null and labelType != ''">#{labelType},</if>
            <if test="matCode != null and matCode != ''">#{matCode},</if>
            <if test="batch != null and batch != ''">#{batch},</if>
            <if test="supplierCode != null and supplierCode != ''">#{supplierCode},</if>
            <if test="supplierName != null and supplierName != ''">#{supplierName},</if>
            <if test="prodTime != null">#{prodTime},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateStockMatLabel" parameterType="StockMatLabel">
        update stock_mat_label
        <trim prefix="SET" suffixOverrides=",">
            <if test="labelCode != null and labelCode != ''">label_code = #{labelCode},</if>
            <if test="labelType != null and labelType != ''">label_type = #{labelType},</if>
            <if test="matCode != null and matCode != ''">mat_code = #{matCode},</if>
            <if test="batch != null and batch != ''">batch = #{batch},</if>
            <if test="supplierCode != null and supplierCode != ''">supplier_code = #{supplierCode},</if>
            <if test="supplierName != null and supplierName != ''">supplier_name = #{supplierName},</if>
            <if test="prodTime != null">prod_time = #{prodTime},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="createBy != null and createBy != ''">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where label_id = #{labelId}
    </update>

    <update id="updateStatus">
        update stock_mat_label
        set status = #{status},
            update_by = #{updateBy},
            update_time = #{updateTime}
        where label_id = #{labelId}
    </update>

    <update id="deleteStockMatLabelByLabelId" parameterType="Long">
        update stock_mat_label SET del_flag = '1' where label_id = #{labelId}
    </update>

    <update id="deleteStockMatLabelByLabelIds" parameterType="String">
        update stock_mat_label SET del_flag = '1' where label_id in
        <foreach item="labelId" collection="array" open="(" separator="," close=")">
            #{labelId}
        </foreach>
    </update>
</mapper>
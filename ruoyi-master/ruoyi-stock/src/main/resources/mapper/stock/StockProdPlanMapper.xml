<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.stock.mapper.StockProdPlanMapper">

    <resultMap type="StockProdPlan" id="StockProdPlanResult">
        <result property="planId"            column="plan_id"             />
        <result property="planNo"            column="plan_no"             />
        <result property="planName"          column="plan_name"           />
        <result property="planType"          column="plan_type"           />
        <result property="planStartDate"     column="plan_start_date"     />
        <result property="planEndDate"       column="plan_end_date"       />
        <result property="matCode"           column="mat_code"            />
        <result property="matName"           column="mat_name"            />
        <result property="planQuantity"      column="plan_quantity"       />
        <result property="actualQuantity"    column="actual_quantity"     />
        <result property="customerOrderNo"   column="customer_order_no"   />
        <result property="workshopCode"      column="workshop_code"       />
        <result property="planStatus"        column="plan_status"         />
        <result property="completionRate"    column="completion_rate"     />
        <result property="delFlag"           column="del_flag"            />
        <result property="createBy"          column="create_by"           />
        <result property="createTime"        column="create_time"         />
        <result property="updateBy"          column="update_by"           />
        <result property="updateTime"        column="update_time"         />
        <result property="remark"            column="remark"              />
    </resultMap>

    <sql id="selectStockProdPlanVo">
        select plan_id, plan_no, plan_name, plan_type, plan_start_date, plan_end_date,
               mat_code, mat_name, plan_quantity, actual_quantity, customer_order_no,
               workshop_code, plan_status, completion_rate,
               del_flag, create_by, create_time, update_by, update_time, remark
        from stock_prod_plan
    </sql>

    <select id="selectStockProdPlanList" parameterType="StockProdPlan" resultMap="StockProdPlanResult">
        <include refid="selectStockProdPlanVo"/>
        WHERE del_flag = '0'
        <if test="planNo != null and planNo != ''"> and plan_no = #{planNo}</if>
        <if test="planName != null and planName != ''"> and plan_name like concat('%', #{planName}, '%')</if>
        <if test="planType != null and planType != ''"> and plan_type = #{planType}</if>
        <if test="matCode != null and matCode != ''"> and mat_code = #{matCode}</if>
        <if test="matName != null and matName != ''"> and mat_name like concat('%', #{matName}, '%')</if>
        <if test="customerOrderNo != null and customerOrderNo != ''"> and customer_order_no = #{customerOrderNo}</if>
        <if test="workshopCode != null and workshopCode != ''"> and workshop_code = #{workshopCode}</if>
        <if test="planStatus != null and planStatus != ''"> and plan_status = #{planStatus}</if>
        <if test="params.beginDate != null and params.beginDate != ''"> and plan_start_date &gt;= #{params.beginDate}</if>
        <if test="params.endDate != null and params.endDate != ''"> and plan_end_date &lt;= #{params.endDate}</if>
        ORDER BY create_time DESC
    </select>

    <select id="selectStockProdPlanByPlanId" parameterType="Long" resultMap="StockProdPlanResult">
        <include refid="selectStockProdPlanVo"/>
        where del_flag = '0' and plan_id = #{planId}
    </select>

    <select id="selectStockProdPlanByPlanNo" resultMap="StockProdPlanResult">
        <include refid="selectStockProdPlanVo"/>
        where del_flag = '0' and plan_no = #{planNo}
    </select>

    <insert id="insertStockProdPlan" parameterType="StockProdPlan" useGeneratedKeys="true" keyProperty="planId">
        insert into stock_prod_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planNo != null">plan_no,</if>
            <if test="planName != null">plan_name,</if>
            <if test="planType != null">plan_type,</if>
            <if test="planStartDate != null">plan_start_date,</if>
            <if test="planEndDate != null">plan_end_date,</if>
            <if test="matCode != null">mat_code,</if>
            <if test="matName != null">mat_name,</if>
            <if test="planQuantity != null">plan_quantity,</if>
            <if test="actualQuantity != null">actual_quantity,</if>
            <if test="customerOrderNo != null">customer_order_no,</if>
            <if test="workshopCode != null">workshop_code,</if>
            <if test="planStatus != null">plan_status,</if>
            <if test="completionRate != null">completion_rate,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planNo != null">#{planNo},</if>
            <if test="planName != null">#{planName},</if>
            <if test="planType != null">#{planType},</if>
            <if test="planStartDate != null">#{planStartDate},</if>
            <if test="planEndDate != null">#{planEndDate},</if>
            <if test="matCode != null">#{matCode},</if>
            <if test="matName != null">#{matName},</if>
            <if test="planQuantity != null">#{planQuantity},</if>
            <if test="actualQuantity != null">#{actualQuantity},</if>
            <if test="customerOrderNo != null">#{customerOrderNo},</if>
            <if test="workshopCode != null">#{workshopCode},</if>
            <if test="planStatus != null">#{planStatus},</if>
            <if test="completionRate != null">#{completionRate},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateStockProdPlan" parameterType="StockProdPlan">
        update stock_prod_plan
        <trim prefix="SET" suffixOverrides=",">
            <if test="planNo != null">plan_no = #{planNo},</if>
            <if test="planName != null">plan_name = #{planName},</if>
            <if test="planType != null">plan_type = #{planType},</if>
            <if test="planStartDate != null">plan_start_date = #{planStartDate},</if>
            <if test="planEndDate != null">plan_end_date = #{planEndDate},</if>
            <if test="matCode != null">mat_code = #{matCode},</if>
            <if test="matName != null">mat_name = #{matName},</if>
            <if test="planQuantity != null">plan_quantity = #{planQuantity},</if>
            <if test="actualQuantity != null">actual_quantity = #{actualQuantity},</if>
            <if test="customerOrderNo != null">customer_order_no = #{customerOrderNo},</if>
            <if test="workshopCode != null">workshop_code = #{workshopCode},</if>
            <if test="planStatus != null">plan_status = #{planStatus},</if>
            <if test="completionRate != null">completion_rate = #{completionRate},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where plan_id = #{planId}
    </update>

    <update id="deleteStockProdPlanByPlanId" parameterType="Long">
        update stock_prod_plan set del_flag = '1' where plan_id = #{planId}
    </update>

    <update id="deleteStockProdPlanByPlanIds" parameterType="String">
        update stock_prod_plan set del_flag = '1' where plan_id in
        <foreach item="planId" collection="array" open="(" separator="," close=")">
            #{planId}
        </foreach>
    </update>
</mapper>

